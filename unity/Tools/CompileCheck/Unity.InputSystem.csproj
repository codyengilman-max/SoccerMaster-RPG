<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Unity.InputSystem</AssemblyName>
    <RootNamespace></RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(UnityManaged)/UnityEngine/UnityEngine.dll" Private="false" />
    <Reference Include="$(UnityManaged)/UnityEngine/UnityEngine.*Module.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="UnityEngine.UI.csproj" Private="false" />
    <Compile Include="$(UnityPkgSrc)/com.unity.inputsystem/InputSystem/**/*.cs"
             Exclude="$(UnityPkgSrc)/com.unity.inputsystem/InputSystem/Runtime/Plugins/InputForUI/**/*.cs;$(UnityPkgSrc)/com.unity.inputsystem/InputSystem/Editor/Plugins/**/*.cs" />
  </ItemGroup>
</Project>
