      "choices": [
        {
          "id": "season.missed.honest",
          "label": "\"I should have been there.\"",
          "eligibility": [],
          "immediate": [
            {
              "type": "clear_fact",
              "id": "missed_match_recent"
            },
            {
              "type": "relationship",
              "personId": "coach",
              "delta": -1
            },
            {
              "type": "track",
              "track": "responsibility",
              "delta": 1
            }
          ],
          "delayed": [],
          "repair": [],
          "expiresDay": null,
          "response": [
            {
              "speaker": "coach",
              "text": "Yes. A team is nine people who turn up. Be one of them."
            }
          ],
          "next": null
        },
        {
          "id": "season.missed.excuse",
          "label": "\"Something came up.\"",
          "eligibility": [],
          "immediate": [
            {
              "type": "clear_fact",
              "id": "missed_match_recent"
            }
          ],
          "delayed": [
            {
              "id": "pattern",
              "afterDays": 10,
              "effects": [
                {
                  "type": "relationship",
                  "personId": "coach",
                  "delta": -2
                },
                {
                  "type": "set_fact",
                  "id": "coach_doubts_excuses",
                  "value": true
                },
                {
                  "type": "learn",
                  "personId": "coach",
                  "factId": "coach_doubts_excuses"
                }
              ],
              "unless": [
                {
                  "type": "fact",
                  "id": "matches_missed",
                  "max": 1
                }
              ]
            }
          ],
          "repair": [],
          "expiresDay": null,
          "response": [
            {
              "speaker": "coach",
              "text": "Then tell me before, not after. That's all I ask."
            }
          ],
          "next": null
        }
      ],
      "next": null,
      "once": false,
      "reviewStatus": "proposal"
    },
    {
      "id": "season.end",
      "title": "Last training of the season",
      "location": "training_field",
      "tone": "reward",
      "eligibility": [
        {
          "type": "fact",
          "id": "season_reviewed",
          "equals": true
        }
      ],
      "lines": [
        {
          "speaker": null,
          "text": "Bibs in the bag, cones in the sack. {coach} gathers everyone in for the last time this season."
        },
        {
          "speaker": "coach",
          "text": "Season's done. League: {season_record}. {season_matches} matches with you in the shirt.",
          "requiresKnown": [
            "season_league_record",
            "season_matches_played"
          ]
        },
        {
          "speaker": "coach",
          "text": "And {season_trophies} weekend where we lifted something. Remember what that took.",
          "requiresKnown": [
            "season_trophies"
          ],
          "when": [
            {
              "type": "fact",
              "id": "season_trophies",
              "min": 1
            }
          ]
        },
        {
          "speaker": "coach",
          "text": "No trophies. Plenty of weekends that mattered anyway. Trophies come later if the work stays.",
          "requiresKnown": [
            "season_trophies"
          ],
          "when": [
            {
              "type": "fact",
              "id": "season_trophies",
              "equals": 0
            }
          ]
        },
        {
          "speaker": "coach",
          "text": "Tryouts are the fifteenth of May. Every club in the valley. I'd like you back, and I'll say that to your face rather than hint at it."
        },
        {
          "speaker": "friend",
          "text": "Same team next year. Right?"
        }
      ],
      "choices": [
        {
          "id": "season.end.stay",
          "label": "\"I want to stay at {club}.\"",
          "eligibility": [],
          "immediate": [
            {
              "type": "set_fact",
              "id": "tryout_intent",
              "value": "stay"
            },
            {
              "type": "learn",
              "personId": "coach",
              "factId": "tryout_intent"
            },
            {
              "type": "relationship",
              "personId": "coach",
              "delta": 1
            }
          ],
          "delayed": [],
          "repair": [],
          "expiresDay": null,
          "response": [
            {
              "speaker": "coach",
              "text": "Good. Then we start again in August, a year better."
            }
          ],
          "next": null
        },
        {
          "id": "season.end.look",
          "label": "\"I want to see what's out there.\"",
          "eligibility": [],
          "immediate": [
            {
              "type": "set_fact",
              "id": "tryout_intent",
              "value": "look"
            },
            {
              "type": "learn",
              "personId": "coach",
              "factId": "tryout_intent"
            },
            {
              "type": "track",
              "track": "pathway",
              "delta": 1
            }
          ],
          "delayed": [],
          "repair": [],
          "expiresDay": null,
          "response": [
            {
              "speaker": "coach",
              "text": "Good. Say it now, in May, to my face — that's how it's done. Whatever you choose, you'll be ready."
            }
          ],
          "next": null
        },
        {
          "id": "season.end.undecided",
          "label": "\"I don't know yet.\"",
          "eligibility": [],
          "immediate": [
            {
              "type": "set_fact",
              "id": "tryout_intent",
              "value": "undecided"
            },
            {
              "type": "learn",
              "personId": "coach",
              "factId": "tryout_intent"
            }
          ],
          "delayed": [],
          "repair": [],
          "expiresDay": null,
          "response": [
            {
              "speaker": "coach",
              "text": "That's an honest answer. Take the week."
            }
          ],
          "next": null
        }
      ],
      "next": null,
      "once": true,
      "reviewStatus": "proposal"
    }
